+  DEFSYM (QCsecond, ":second");
+  DEFSYM (QCshow_previews, ":show-previews");
+  DEFSYM (QCsound, ":sound");
+  DEFSYM (QCsound_setting, ":sound-setting");
+  DEFSYM (QCsubtitle, ":subtitle");
