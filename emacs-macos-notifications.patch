+  DEFSYM (Qactive, "active");
+  DEFSYM (Qalert, "alert");
+  DEFSYM (Qalways, "always");
+  DEFSYM (Qauthorized, "authorized");
+  DEFSYM (Qbadge, "badge");
+  DEFSYM (Qbanner, "banner");
+  DEFSYM (Qcritical, "critical");
+  DEFSYM (Qcustom_dismiss, "custom-dismiss");
+  DEFSYM (Qdefault, "default");
+  DEFSYM (Qdenied, "denied");
+  DEFSYM (Qdisabled, "disabled");
+  DEFSYM (Qenabled, "enabled");
+  DEFSYM (Qhidden_previews_show_subtitle, "hidden-previews-show-subtitle");
+  DEFSYM (Qhidden_previews_show_title, "hidden-previews-show-title");
+  DEFSYM (Qlist, "list");
+  DEFSYM (Qnever, "never");
+  DEFSYM (Qnone, "none");
+  DEFSYM (Qnot_determined, "not-determined");
+  DEFSYM (Qnot_supported, "not-supported");
+  DEFSYM (Qpassive, "passive");
+  DEFSYM (Qprovisional, "provisional");
+  DEFSYM (Qtime_sensitive, "time-sensitive");
+  DEFSYM (Qwhen_authenticated, "when-authenticated");
+
+  /* Called with one argument, the property list describing a response.
+     Named here rather than looked up per notification because a response
+     may concern a notification posted by an earlier Emacs session.  */
+  DEFSYM (Qns_notification_handle_response, "ns-notification-handle-response");
+
+  DEFVAR_LISP ("ns-notification-foreground-presentation",
+	       Vns_notification_foreground_presentation,
+	       doc: /* How to present notifications while Emacs is frontmost.
+
+macOS withholds notifications from the application the user is already
+looking at unless that application asks for them anyway.  Since a
+notification Emacs posts is usually about something outside the frame the
+user is watching, Emacs does ask.
+
+The value is a list of symbols drawn from `banner' (show it on screen),
+`list' (keep it in Notification Center), `sound' (play its sound) and
+`badge' (update the Dock icon).  A nil value suppresses notifications
+while Emacs is frontmost, which is the system default behavior.
+
+Before macOS 11 there was no distinction between `banner' and `list';
+either one asks for the single alert of those versions.  */);
+  Vns_notification_foreground_presentation = list3 (Qbanner, Qlist, Qsound);
+
+  /* Callbacks for asynchronous queries in flight.  Not documented: this
+     is an implementation detail of the functions that take a handler.  */
+  ns_notify_pending = CALLN (Fmake_hash_table, QCtest, Qeql);
+  staticpro (&ns_notify_pending);
+
+  defsubr (&Sns_notification_available_p);
+  defsubr (&Sns_notification_request_authorization);
