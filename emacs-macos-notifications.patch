+  defsubr (&Sns_notification_get_categories);
+  defsubr (&Sns_notification_add);
+  defsubr (&Sns_notification_remove);
+  defsubr (&Sns_notification_remove_all);
+  defsubr (&Sns_notification_get_delivered);
+  defsubr (&Sns_notification_get_pending);
+#endif /* NS_USE_USER_NOTIFICATIONS */
+}
