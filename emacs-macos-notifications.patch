diff --git c/lisp/term/ns-notifications.el i/lisp/term/ns-notifications.el
new file mode 100644
index 00000000000..e72ea96b3e9
--- /dev/null
+++ i/lisp/term/ns-notifications.el
@@ -0,0 +1,457 @@
+;;; ns-notifications.el --- macOS desktop notifications  -*- lexical-binding: t -*-
+
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+
+;; Keywords: terminals
+
+;; This file is part of GNU Emacs.
+
+;; GNU Emacs is free software: you can redistribute it and/or modify
+;; it under the terms of the GNU General Public License as published by
+;; the Free Software Foundation, either version 3 of the License, or
+;; (at your option) any later version.
+
+;; GNU Emacs is distributed in the hope that it will be useful,
+;; but WITHOUT ANY WARRANTY; without even the implied warranty of
+;; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+;; GNU General Public License for more details.
+
+;; You should have received a copy of the GNU General Public License
+;; along with GNU Emacs.  If not, see <https://www.gnu.org/licenses/>.
+
+;;; Commentary:
+
+;; The Lisp half of the interface to macOS's UNUserNotificationCenter.
+;; The primitives it builds on live in src/nsnotify.m and stay close to
+;; the framework; this file supplies the parts that are pleasanter to
+;; write in Lisp: keyword handling, the registry pairing a notification
+;; with the functions to call when the user acts on it, a category
+;; registry, and `ns-notifications-notify', which accepts the arguments
+;; `notifications-notify' does.
+
+;; Two things about the framework are worth knowing before using this.
+
+;; Buttons cannot be attached to a single notification.  They belong to a
+;; category, which is registered once and named by any number of
+;; notifications.  `ns-notification-notify' hides that when given
+;; `:actions', by defining a category behind the scenes, but a category
+;; defined with `ns-notification-define-category' can do considerably
+;; more, including replies typed into the notification itself.
+
+;; There is no callback for a notification expiring.  A banner hides
+;; itself after a few seconds but the notification stays in Notification
+;; Center until something removes it, and `:on-close' runs only when the
+;; user dismisses it deliberately.
+
+;;; Code:
+
+(declare-function ns-notification-available-p "nsnotify.m" ())
+(declare-function ns-notification-add "nsnotify.m" (plist))
+(declare-function ns-notification-remove "nsnotify.m" (ids &optional pending))
+(declare-function ns-notification-remove-all "nsnotify.m" (&optional pending))
+(declare-function ns-notification-set-categories "nsnotify.m" (categories))
+(declare-function ns-notification-request-authorization "nsnotify.m"
+                  (&optional options handler))
+
+(defvar ns-notification-foreground-presentation)
+
+;;; Customization
+
+(defgroup ns-notifications nil
+  "Desktop notifications on macOS."
+  :group 'ns
+  :version "31.1")
+
+(defcustom ns-notification-request-authorization-on-first-use t
+  "Whether to ask the system for permission before the first notification.
+
+macOS refuses to display notifications from an application that has not
+asked for permission, and prompts the user the first time one asks.  When
+this is non-nil Emacs asks as late as possible, when it has an actual
+notification to show, so that the prompt arrives with some context rather
+than during startup.
+
+Set this to nil to take charge yourself with
+`ns-notification-request-authorization'."
+  :type 'boolean
+  :group 'ns-notifications)
+
+(defcustom ns-notification-default-sound nil
+  "Sound for notifications that do not specify one.
+
+The value t means the system default sound, a string names a sound in
+~/Library/Sounds or /System/Library/Sounds, and nil means silence."
+  :type '(choice (const :tag "Silent" nil)
+                 (const :tag "System default" t)
+                 (string :tag "Named sound"))
+  :group 'ns-notifications)
+
+(defcustom ns-notification-response-functions nil
+  "Functions to call when the user acts on any notification.
+
+Each function receives one argument, the property list describing the
+response, as documented in `ns-notification-handle-response'.  They run
+in addition to the per-notification handlers given to
+`ns-notification-notify'.
+
+Unlike those handlers, these run even for a notification posted by an
+earlier Emacs session, which macOS may keep on screen across a restart
+and about which this session knows nothing."
+  :type 'hook
+  :group 'ns-notifications)
+
+;;; State
+
+(defvar ns-notification--handlers (make-hash-table :test #'equal)
+  "Handlers for notifications posted by this Emacs session.
+Maps a notification identifier to the property list it was posted with.")
+
+(defvar ns-notification-categories nil
+  "Categories registered with the system, as an alist.
+
+Keys are category identifier strings and values are the property lists
+described by `ns-notification-set-categories'.  Use
+`ns-notification-define-category' to add to this rather than setting it
+directly, since the system must be told about the whole set at once.")
+
+(defvar ns-notification--authorization-requested nil
+  "Whether permission has been asked for in this session.")
+
+;;; Availability
+
+(defun ns-notification-usable-p ()
+  "Return non-nil if notifications can be posted right now.
+
+This is `ns-notification-available-p' with a check that the function
+exists at all, so that it is safe to call on any Emacs.  Code choosing
+between notification backends should use this."
+  (and (fboundp 'ns-notification-available-p)
+       (ns-notification-available-p)))
+
+(defun ns-notification--ensure-authorization ()
+  "Ask the system for permission to notify, at most once per session."
+  (when (and ns-notification-request-authorization-on-first-use
+             (not ns-notification--authorization-requested))
+    (setq ns-notification--authorization-requested t)
+    (ns-notification-request-authorization '(alert sound badge) nil)))
+
+;;; Categories
+
+(defun ns-notification--push-categories ()
+  "Tell the system about every category in `ns-notification-categories'.
+The framework replaces its whole set on each call, so this sends all of
+them even when only one has changed."
+  (ns-notification-set-categories (mapcar #'cdr ns-notification-categories)))
+
+(defun ns-notification-define-category (id &rest args)
+  "Define notification category ID, a string, and register it.
+
+ARGS is a property list accepting `:actions', `:intents' and `:options',
+each as described in `ns-notification-set-categories'.  Defining a
+category whose ID is already known replaces it.
+
+Categories persist for the session, so a package can define its
+categories once when it loads and thereafter refer to them by ID."
+  (let ((category (append (list :id id) args)))
+    (setq ns-notification-categories
+          (cons (cons id category)
+                (assoc-delete-all id ns-notification-categories)))
+    (ns-notification--push-categories)
+    id))
+
+(defun ns-notification-undefine-category (id)
+  "Remove notification category ID and tell the system."
+  (setq ns-notification-categories
+        (assoc-delete-all id ns-notification-categories))
+  (ns-notification--push-categories)
+  nil)
+
+(defun ns-notification--actions-to-category (actions on-close)
+  "Return the id of a category offering ACTIONS, defining it if needed.
+
+ACTIONS is a flat list of strings, (KEY TITLE KEY TITLE ...), in the form
+`notifications-notify' accepts.  The key \"default\" is implicit on macOS
+\(clicking the notification body) and is dropped if present.
+
+ON-CLOSE non-nil adds the option that makes the system report deliberate
+dismissals, without which `:on-close' would never run.
+
+The category is named after a hash of its own contents, so that repeated
+calls with the same actions reuse one category rather than accumulating
+near-duplicates."
+  (let (specs)
+    (while actions
+      (let ((key (pop actions))
+            (title (pop actions)))
+        ;; A "default" action needs no button: the notification body
+        ;; already acts as one.
+        (unless (equal key "default")
+          (push (list :id key :title title) specs))))
+    (setq specs (nreverse specs))
+    (let* ((options (and on-close '(custom-dismiss)))
+           (id (concat "emacs-auto-"
+                       (secure-hash 'sha1 (prin1-to-string
+                                           (list specs options))))))
+      (unless (assoc id ns-notification-categories)
+        (ns-notification-define-category id :actions specs :options options))
+      id)))
+
+;;; Posting
+
+(defconst ns-notification--urgency-levels
+  '((low . passive) (normal . active) (critical . time-sensitive))
+  "Mapping from `notifications-notify' urgencies to interruption levels.
+
+macOS has no exact counterpart of `critical': a genuinely critical alert,
+which can pierce Do Not Disturb, needs an entitlement granted by Apple
+that Emacs does not have.  `time-sensitive' is the closest thing
+available.")
+
+(defun ns-notification--interruption-level (urgency)
+  "Return the interruption level corresponding to URGENCY."
+  (declare (side-effect-free t))
+  (or (cdr (assq urgency ns-notification--urgency-levels))
+      (error "Invalid urgency: %s" urgency)))
+
+(defun ns-notification-notify (&rest args)
+  "Post a desktop notification and return its identifier, a string.
+
+Posting a notification whose identifier matches one already posted
+replaces it, which is how a notification is updated in place.
+
+ARGS is a property list.  Describing what is shown:
+
+  :title       String shown as the heading.
+  :subtitle    String shown under the title.
+  :body        String of body text.
+  :id          String identifying this notification.  One is generated
+               if omitted.  `:replaces-id' is accepted as a synonym.
+  :group       String grouping related notifications in Notification
+               Center.
+  :sound       t for the system sound, a string naming a sound in
+               ~/Library/Sounds or /System/Library/Sounds, or nil for
+               silence.  Defaults to `ns-notification-default-sound'.
+  :badge       Integer to show on the Dock icon.
+  :attachments List of property lists, each with at least a `:file'.
+               The file is copied into the system's store, so a
+               temporary file may be deleted afterwards.
+  :urgency     One of `low', `normal' or `critical'.
+  :interruption-level
+               Set the level directly, as `passive', `active',
+               `time-sensitive' or `critical'.  Overrides `:urgency'.
+  :relevance-score
+               Float from 0.0 to 1.0 ordering notifications in a group.
+  :user-info   Any printable Lisp object, handed back to the handlers
+               below.  It is stored by the system alongside the
+               notification, so it is the only thing that survives into
+               a later Emacs session.
+
+Choosing when it appears:
+
+  :after       Show it this many seconds from now instead of at once.
+  :at          Show it at a matching time, given as a property list of
+               `:year', `:month', `:day', `:hour', `:minute', `:second'
+               and `:weekday'.
+  :repeat      Repeat it.  With `:after' the interval must be at least
+               60 seconds.
+  :timeout     Withdraw it after this many milliseconds.  macOS has no
+               notion of expiry, so this is an Emacs timer that calls
+               `ns-notification-close'.
+
+Reacting to the user:
+
+  :actions     Flat list of strings (KEY TITLE KEY TITLE ...) naming
+               buttons, as in `notifications-notify'.  For more than
+               plain buttons, including replies typed into the
+               notification, define a category with
+               `ns-notification-define-category' and name it with
+               `:category' instead.
+  :category    Identifier of a category supplying the buttons.
+  :on-action   Function called with the identifier and the key of the
+               button chosen.  The key is \"default\" when the user
+               clicked the notification itself.
+  :on-reply    Function called with the identifier, the key, and the
+               text, when the user replies to a text-input action.
+               Falls back to `:on-action' if not given.
+  :on-close    Function called with the identifier and the symbol
+               `dismissed' when the user dismisses the notification.
+               Only deliberate dismissal is reported, and only when the
+               category allows it, which `:actions' arranges for you.
+  :handler     Function called with the whole response property list,
+               as described in `ns-notification-handle-response'.
+  :resident    Keep the handlers registered after an action fires,
+               instead of forgetting the notification.
+
+Signal an error if notifications are unavailable; see
+`ns-notification-available-p'.  Note that macOS hides notifications from
+whichever application is frontmost unless asked otherwise, which
+`ns-notification-foreground-presentation' does by default."
+  (unless (ns-notification-available-p)
+    (error "Notifications are unavailable; Emacs must run from an %s"
+           "application bundle registered with Launch Services"))
+  (ns-notification--ensure-authorization)
+  (let* ((on-close (plist-get args :on-close))
+         (actions (plist-get args :actions))
+         (category (or (plist-get args :category)
+                       (and (or actions on-close)
+                            (ns-notification--actions-to-category
+                             actions on-close))))
+         (urgency (plist-get args :urgency))
+         (id (ns-notification-add
+              (ns-notification--build-request args category urgency)))
+         (timeout (plist-get args :timeout)))
+    (puthash id args ns-notification--handlers)
+    (when (and (natnump timeout) (> timeout 0))
+      (run-with-timer (/ timeout 1000.0) nil #'ns-notification-close id))
+    id))
+
+(defun ns-notification--build-request (args category urgency)
+  "Return the property list to hand to `ns-notification-add'.
+ARGS is as given to `ns-notification-notify'.  CATEGORY is the category
+identifier to use, or nil.  URGENCY is its `:urgency', or nil."
+  (let ((request nil))
+    ;; Copy across everything the primitive understands unchanged.
+    (dolist (key '(:title :subtitle :body :group :badge :attachments
+                   :user-info :relevance-score :after :at :repeat))
+      (when-let* ((value (plist-get args key)))
+        (setq request (plist-put request key value))))
+    (when-let* ((id (or (plist-get args :id) (plist-get args :replaces-id))))
+      (setq request (plist-put request :id (ns-notification--id-string id))))
+    (when category
+      (setq request (plist-put request :category category)))
+    (setq request
+          (plist-put request :sound
+                     (if (plist-member args :sound)
+                         (plist-get args :sound)
+                       ns-notification-default-sound)))
+    (when-let* ((level (or (plist-get args :interruption-level)
+                           (and urgency
+                                (ns-notification--interruption-level
+                                 urgency)))))
+      (setq request (plist-put request :interruption-level level)))
+    request))
+
+(defun ns-notification--id-string (id)
+  "Return ID as a notification identifier string.
+Integers are accepted because `notifications-notify' hands out integer
+identifiers and callers pass them straight back as `:replaces-id'."
+  (declare (side-effect-free t))
+  (if (stringp id) id (format "%s" id)))
+
+(defun ns-notification-close (id)
+  "Withdraw the notification identified by ID and forget its handlers."
+  (remhash id ns-notification--handlers)
+  (when (ns-notification-available-p)
+    (ns-notification-remove (list id))))
+
+(defun ns-notification-close-all (&optional pending)
+  "Withdraw every notification Emacs has delivered.
+With PENDING non-nil, cancel the ones scheduled but not yet delivered."
+  (unless pending
+    (clrhash ns-notification--handlers))
+  (when (ns-notification-available-p)
+    (ns-notification-remove-all pending)))
+
+;;; Responses
+
+(defun ns-notification-handle-response (response)
+  "Dispatch RESPONSE, a notification the user acted on.
+
+This is called from the command loop by src/nsnotify.m and is not meant
+to be called from Lisp.
+
+RESPONSE is a property list with these keys:
+
+  :id          Identifier of the notification.
+  :action      Key of the button chosen, \"default\" if the user clicked
+               the notification itself, or \"dismiss\" if it was
+               dismissed.
+  :text        Text the user typed, for a reply action, else nil.
+  :title, :subtitle, :body, :category, :group
+               The content of the notification.
+  :user-info   The `:user-info' it was posted with.
+  :date        Time of delivery, as seconds since the epoch.
+
+The handlers registered for the notification run first, then
+`ns-notification-response-functions'.  A notification posted by an
+earlier Emacs session has no registered handlers, so only the latter
+run."
+  (let* ((id (plist-get response :id))
+         (args (gethash id ns-notification--handlers)))
+    (when args
+      (ns-notification--run-handlers response id args)
+      (unless (plist-get args :resident)
+        (remhash id ns-notification--handlers)))
+    (run-hook-with-args 'ns-notification-response-functions response)))
+
+(defun ns-notification--run-handlers (response id args)
+  "Call the handlers in ARGS that apply to RESPONSE for notification ID."
+  (let ((action (plist-get response :action))
+        (text (plist-get response :text)))
+    (when-let* ((handler (plist-get args :handler)))
+      (funcall handler response))
+    (cond
+     ((equal action "dismiss")
+      (when-let* ((handler (plist-get args :on-close)))
+        (funcall handler id 'dismissed)))
+     (text
+      (if-let* ((handler (plist-get args :on-reply)))
+          (funcall handler id action text)
+        (when-let* ((handler (plist-get args :on-action)))
+          (funcall handler id action))))
+     (t
+      (when-let* ((handler (plist-get args :on-action)))
+        (funcall handler id action))))))
+
+;;; Compatibility with notifications.el
+
+(defun ns-notifications-notify (&rest params)
+  "Post a notification, accepting the arguments `notifications-notify' does.
+
+This is a restricted pastiche of the D-Bus desktop notification
+interface, in the manner of `w32-notification-notify' and
+`android-notifications-notify', provided so that code written against
+`notifications-notify' works unchanged on macOS.  New code should prefer
+`ns-notification-notify', which reaches the whole of what macOS offers.
+
+These parameters have the same meaning as they do in
+`notifications-notify': `:title', `:body', `:replaces-id', `:actions',
+`:timeout', `:urgency', `:resident', `:on-action' and `:on-close'.
+`:sound-name' and `:sound-file' both choose a sound, and
+`:suppress-sound' silences the notification.
+
+The value is a string, not an integer as on other systems, because macOS
+identifies notifications by name.  It can be passed back as
+`:replaces-id' in the usual way.
+
+The remaining parameters of `notifications-notify' are accepted and
+ignored, having no counterpart here.  In particular macOS shows the
+icon of the sending application and offers no way to override it, so
+`:app-name' and `:app-icon' do nothing; use the `:attachments' parameter
+of `ns-notification-notify' to show an image."
+  (let ((args (ns-notification--compat-sound params))
+        (tail params))
+    (while tail
+      (let ((key (car tail))
+            (value (cadr tail)))
+        (when (memq key '(:title :body :replaces-id :actions :timeout
+                          :urgency :resident :on-action :on-close))
+          (setq args (append args (list key value)))))
+      (setq tail (cddr tail)))
+    (apply #'ns-notification-notify args)))
+
+(defun ns-notification--compat-sound (params)
+  "Return the `:sound' argument implied by PARAMS, as a property list."
+  (cond
+   ((plist-get params :suppress-sound) '(:sound nil))
+   ((plist-get params :sound-name) (list :sound (plist-get params :sound-name)))
+   ((when-let* ((file (plist-get params :sound-file)))
+      ;; macOS resolves sounds by name from a handful of directories and
+      ;; cannot be pointed at an arbitrary file, so the best that can be
+      ;; done is to try the file's name.
+      (list :sound (file-name-base file))))
+   (t nil)))
+
+(provide 'ns-notifications)
+
+;;; ns-notifications.el ends here
