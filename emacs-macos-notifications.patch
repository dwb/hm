diff --git c/src/nsnotify.m i/src/nsnotify.m
new file mode 100644
index 00000000000..92fac57fffd
--- /dev/null
+++ i/src/nsnotify.m
@@ -0,0 +1,1593 @@
+/* Desktop notifications for the NeXT/Open/GNUstep and macOS window system.
+
+Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GNU Emacs.
+
+GNU Emacs is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or (at
+your option) any later version.
+
+GNU Emacs is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GNU Emacs.  If not, see <https://www.gnu.org/licenses/>.  */
+
+/* This file binds macOS's UNUserNotificationCenter.  The functions here
+   are deliberately thin: they translate between Lisp property lists and
+   the framework's objects and do nothing else.  The ergonomic interface,
+   including the `notifications-notify' compatibility shim and the
+   registry pairing notifications with their callbacks, lives in
+   lisp/term/ns-notifications.el.
+
+   Three properties of the framework shape everything below.
+
+   It is unavailable unless Emacs runs from an application bundle that
+   Launch Services knows about, so every entry point first consults
+   `ns-notification-available-p'.
+
+   Its query methods are asynchronous and call back on an arbitrary
+   queue, where touching a Lisp object would be unsafe and where a
+   captured Lisp_Object would be invisible to the garbage collector.
+   Callbacks are therefore held in a hash table keyed by an integer
+   token; a completion block captures only the token, retains its result,
+   and hands both to the main thread with performSelectorOnMainThread:.
+
+   Responses to a notification may arrive for one posted by an earlier
+   Emacs session, since macOS keeps delivered notifications across
+   restarts.  No C-side registry could survive that, so responses are
+   always dispatched to the fixed symbol `ns-notification-handle-response'
+   and Lisp decides what to do with them.  */
+
+/* This should be the first include, as it may set up #defines affecting
+   interpretation of even the system includes.  */
+#include <config.h>
+
+#include "lisp.h"
+#include "blockinput.h"
+#include "coding.h"
+#include "keyboard.h"
+#include "termhooks.h"
+#include "nsterm.h"
+
+#if NS_USE_USER_NOTIFICATIONS
+
+#import <UserNotifications/UserNotifications.h>
+
+/* UNNotificationPresentationOptionAlert was split into separate banner
+   and list options in macOS 11.  */
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 110000
+#define NS_UN_PRESENT_BANNER UNNotificationPresentationOptionBanner
+#define NS_UN_PRESENT_LIST   UNNotificationPresentationOptionList
+#else
+#define NS_UN_PRESENT_BANNER UNNotificationPresentationOptionAlert
+#define NS_UN_PRESENT_LIST   UNNotificationPresentationOptionAlert
+#endif
+
+/* Which kind of result a completion block produced, so that the
+   main-thread half knows how to convert it.  */
+
+enum ns_notify_result
+{
+  ns_notify_result_authorization,	/* @[granted, error]  */
+  ns_notify_result_settings,		/* UNNotificationSettings  */
+  ns_notify_result_categories,		/* NSSet of UNNotificationCategory  */
+  ns_notify_result_notifications,	/* NSArray of UNNotification  */
+  ns_notify_result_requests,		/* NSArray of UNNotificationRequest  */
+  ns_notify_result_error		/* NSError or nil  */
+};
+
+/* Whether a usable notification centre exists: -1 not yet determined,
+   0 no, 1 yes.  Only a determination made with NSApp present is cached,
+   since a nil NSApp merely means Emacs has not connected to the window
+   system yet.  */
+static int ns_notify_availability = -1;
+
+/* Callbacks for asynchronous queries still in flight, keyed by an
+   integer token.  Staticpro'd: a completion block cannot hold a
+   Lisp_Object safely.  */
+static Lisp_Object ns_notify_pending;
+
+/* Source of those tokens, and of automatic notification identifiers.  */
+static EMACS_INT ns_notify_counter;
+
+/* The notification centre delegate, or nil before it is installed.  */
+static id ns_notify_delegate;
+
+
+/* ==========================================================================
+
+    Availability
+
+   ========================================================================== */
+
+/* Return true if this Emacs can post notifications.
+
+   -[UNUserNotificationCenter currentNotificationCenter] raises
+   NSInternalInconsistencyException when the process has no bundle
+   identity, which is the case when src/emacs is run straight from a
+   build tree, so the call is made once behind @try and the answer
+   remembered.  */
+
+static bool
+ns_notify_available_p (void)
+{
+  if (ns_notify_availability >= 0)
+    return ns_notify_availability > 0;
+
+  /* Without a window system connection there is no run loop to deliver
+     responses on.  Do not cache this; NSApp may yet appear.  */
+  if (NSApp == nil)
+    return false;
+
+  ns_notify_availability = 0;
+
+  if ([[NSBundle mainBundle] bundleIdentifier] != nil
+      && NSClassFromString (@"UNUserNotificationCenter") != nil)
+    {
+      @try
+	{
+	  if ([UNUserNotificationCenter currentNotificationCenter] != nil)
+	    ns_notify_availability = 1;
+	}
+      @catch (NSException *exception)
+	{
+	  ns_notify_availability = 0;
+	}
+    }
+
+  return ns_notify_availability > 0;
+}
+
+/* Return the notification centre, signalling if there is none.  */
+
+static UNUserNotificationCenter *
+ns_notify_center (void)
+{
+  if (!ns_notify_available_p ())
+    error ("Notifications are unavailable; Emacs must run from an"
+	   " application bundle registered with Launch Services");
+
+  /* Normally the delegate was installed at launch, but a notification
+     centre reached before then would have nothing to forward results
+     to, so make sure of it here as well.  */
+  ns_init_notifications ();
+
+  return [UNUserNotificationCenter currentNotificationCenter];
+}
+
+
+/* ==========================================================================
+
+    Conversions from the framework to Lisp
+
+   ========================================================================== */
+
+/* Return STRING as a Lisp string, or nil.  */
+
+static Lisp_Object
+ns_notify_string (NSString *string)
+{
+  return string ? [string lispString] : Qnil;
+}
+
+/* Return DATE as a Lisp timestamp, or nil.  */
+
+static Lisp_Object
+ns_notify_date (NSDate *date)
+{
+  if (!date)
+    return Qnil;
+
+  return make_float ([date timeIntervalSince1970]);
+}
+
+/* The key under which `:user-info' is stashed in a notification's
+   userInfo dictionary.  Its value is a printed Lisp object: the
+   dictionary must survive being written to and read back from macOS's
+   own notification store, which only handles property list types.  */
+#define NS_NOTIFY_USER_INFO_KEY @"emacs-user-info"
+
+static Lisp_Object
+ns_notify_read_1 (void *ptr)
+{
+  return Fcar (Fread_from_string (*(Lisp_Object *) ptr, Qnil, Qnil));
+}
+
+static Lisp_Object
+ns_notify_read_2 (enum nonlocal_exit exit, Lisp_Object error)
+{
+  return Qnil;
+}
+
+/* Return the `:user-info' carried by USER_INFO, or nil.
+
+   Reading is guarded because not everything that prints reads back: a
+   caller may have passed an object such as a buffer, whose printed form
+   is not valid input.  A `:user-info' that cannot be recovered is
+   reported as nil rather than losing the whole response.  */
+
+static Lisp_Object
+ns_notify_user_info (NSDictionary *user_info)
+{
+  NSString *printed = [user_info objectForKey: NS_NOTIFY_USER_INFO_KEY];
+  Lisp_Object string;
+
+  if (![printed isKindOfClass: [NSString class]])
+    return Qnil;
+
+  string = [printed lispString];
+
+  return internal_catch_all (ns_notify_read_1, &string, ns_notify_read_2);
+}
+
+static Lisp_Object
+ns_notify_authorization_status (UNAuthorizationStatus status)
+{
+  switch (status)
+    {
+    case UNAuthorizationStatusDenied:	   return Qdenied;
+    case UNAuthorizationStatusAuthorized:  return Qauthorized;
+    case UNAuthorizationStatusProvisional: return Qprovisional;
+    default:				   return Qnot_determined;
+    }
+}
+
+static Lisp_Object
+ns_notify_setting (UNNotificationSetting setting)
+{
+  switch (setting)
+    {
+    case UNNotificationSettingEnabled:  return Qenabled;
+    case UNNotificationSettingDisabled: return Qdisabled;
+    default:				return Qnot_supported;
+    }
+}
+
+static Lisp_Object
+ns_notify_alert_style (UNAlertStyle style)
+{
+  switch (style)
+    {
+    case UNAlertStyleBanner: return Qbanner;
+    case UNAlertStyleAlert:  return Qalert;
+    default:		     return Qnone;
+    }
+}
+
+static Lisp_Object
+ns_notify_show_previews (UNShowPreviewsSetting setting)
+{
+  switch (setting)
+    {
+    case UNShowPreviewsSettingWhenAuthenticated: return Qwhen_authenticated;
+    case UNShowPreviewsSettingNever:		 return Qnever;
+    default:					 return Qalways;
+    }
+}
+
+/* Return SETTINGS as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_settings (UNNotificationSettings *settings)
+{
+  Lisp_Object plist
+    = CALLN (Flist, QCauthorization_status,
+	     ns_notify_authorization_status ([settings authorizationStatus]),
+	     QCalert_setting, ns_notify_setting ([settings alertSetting]),
+	     QCsound_setting, ns_notify_setting ([settings soundSetting]),
+	     QCbadge_setting, ns_notify_setting ([settings badgeSetting]));
+
+  plist = nconc2 (plist,
+		  CALLN (Flist, QCnotification_center_setting,
+			 ns_notify_setting ([settings
+					      notificationCenterSetting]),
+			 QClock_screen_setting,
+			 ns_notify_setting ([settings lockScreenSetting]),
+			 QCalert_style,
+			 ns_notify_alert_style ([settings alertStyle]),
+			 QCshow_previews,
+			 ns_notify_show_previews ([settings
+						    showPreviewsSetting])));
+
+  /* Added in macOS 12; ask before using, since Emacs may be running on
+     something older than the SDK it was built against.  */
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 120000
+  if ([settings respondsToSelector: @selector (timeSensitiveSetting)])
+    plist = nconc2 (plist,
+		    list4 (QCtime_sensitive_setting,
+			   ns_notify_setting ([settings timeSensitiveSetting]),
+			   QCscheduled_delivery_setting,
+			   ns_notify_setting ([settings
+						scheduledDeliverySetting])));
+#endif
+
+  return plist;
+}
+
+/* Return the identifier Lisp should see for the action ACTION of a
+   response.  The framework's two built-in identifiers are opaque
+   strings; give them the names `notifications-notify' uses.  */
+
+static Lisp_Object
+ns_notify_action_name (NSString *action)
+{
+  if ([action isEqualToString: UNNotificationDefaultActionIdentifier])
+    return build_string ("default");
+  if ([action isEqualToString: UNNotificationDismissActionIdentifier])
+    return build_string ("dismiss");
+
+  return ns_notify_string (action);
+}
+
+/* Return the content of NOTIFICATION as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_content (UNNotificationContent *content)
+{
+  return CALLN (Flist, QCtitle, ns_notify_string ([content title]),
+		QCsubtitle, ns_notify_string ([content subtitle]),
+		QCbody, ns_notify_string ([content body]),
+		QCuser_info, ns_notify_user_info ([content userInfo]));
+}
+
+/* Return REQUEST as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_request (UNNotificationRequest *request)
+{
+  UNNotificationContent *content = [request content];
+
+  return nconc2 (CALLN (Flist, QCid, ns_notify_string ([request identifier]),
+			QCcategory,
+			ns_notify_string ([content categoryIdentifier]),
+			QCgroup,
+			ns_notify_string ([content threadIdentifier])),
+		 ns_notify_lisp_from_content (content));
+}
+
+/* Return NOTIFICATION, which has been delivered, as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_notification (UNNotification *notification)
+{
+  return nconc2 (list2 (QCdate, ns_notify_date ([notification date])),
+		 ns_notify_lisp_from_request ([notification request]));
+}
+
+/* Return ACTION as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_action (UNNotificationAction *action)
+{
+  UNNotificationActionOptions options = [action options];
+  Lisp_Object plist
+    = CALLN (Flist, QCid, ns_notify_string ([action identifier]),
+	     QCtitle, ns_notify_string ([action title]),
+	     QCforeground,
+	     (options & UNNotificationActionOptionForeground) ? Qt : Qnil);
+
+  plist = nconc2 (plist,
+		  list4 (QCdestructive,
+			 (options & UNNotificationActionOptionDestructive)
+			 ? Qt : Qnil,
+			 QCauthenticate,
+			 (options
+			  & UNNotificationActionOptionAuthenticationRequired)
+			 ? Qt : Qnil));
+
+  if ([action isKindOfClass: [UNTextInputNotificationAction class]])
+    {
+      UNTextInputNotificationAction *text
+	= (UNTextInputNotificationAction *) action;
+
+      plist = nconc2 (plist,
+		      CALLN (Flist, QCtext_input, Qt,
+			     QCbutton_title,
+			     ns_notify_string ([text textInputButtonTitle]),
+			     QCplaceholder,
+			     ns_notify_string ([text
+						 textInputPlaceholder])));
+    }
+
+  return plist;
+}
+
+/* Return CATEGORY as a property list.  */
+
+static Lisp_Object
+ns_notify_lisp_from_category (UNNotificationCategory *category)
+{
+  Lisp_Object actions = Qnil, intents = Qnil;
+
+  for (UNNotificationAction *action in [category actions])
+    actions = Fcons (ns_notify_lisp_from_action (action), actions);
+
+  for (NSString *intent in [category intentIdentifiers])
+    intents = Fcons (ns_notify_string (intent), intents);
+
+  return CALLN (Flist, QCid, ns_notify_string ([category identifier]),
+		QCactions, Fnreverse (actions),
+		QCintents, Fnreverse (intents));
+}
+
+
+/* ==========================================================================
+
+    Delivering results to Lisp
+
+   ========================================================================== */
+
+/* What ns_notify_deliver_1 needs to do its work.  */
+
+struct ns_notify_delivery
+{
+  /* The token of the callback to run, or 0 to dispatch a notification
+     response to `ns-notification-handle-response'.  */
+  EMACS_INT token;
+
+  /* Which sort of RESULT this is; meaningless when TOKEN is 0.  */
+  enum ns_notify_result kind;
+
+  /* The Objective C object the framework handed us, already retained.  */
+  id result;
+};
+
+/* Queue an event applying the callback identified by DATA to the Lisp
+   translation of its result.  Runs on the main thread, wrapped by
+   internal_catch_all, because converting the result can signal.  */
+
+static Lisp_Object
+ns_notify_deliver_1 (void *ptr)
+{
+  struct ns_notify_delivery *data = ptr;
+  specpdl_ref count = SPECPDL_INDEX ();
+  Lisp_Object handler, argument;
+  struct input_event ie;
+
+  specbind (Qinhibit_quit, Qt);
+
+  if (data->token == 0)
+    {
+      /* A response to a notification.  The notification may have been
+	 posted by a previous Emacs session, so there is nothing to look
+	 up: Lisp works out for itself whether it knows this one.  */
+      UNNotificationResponse *response = data->result;
+      Lisp_Object text = Qnil;
+
+      handler = Qns_notification_handle_response;
+
+      if ([response isKindOfClass: [UNTextInputNotificationResponse class]])
+	{
+	  UNTextInputNotificationResponse *input
+	    = (UNTextInputNotificationResponse *) response;
+	  text = ns_notify_string ([input userText]);
+	}
+
+      argument
+	= nconc2 (list4 (QCaction,
+			 ns_notify_action_name ([response actionIdentifier]),
+			 QCtext, text),
+		  ns_notify_lisp_from_notification ([response notification]));
+    }
+  else
+    {
+      Lisp_Object token = make_int (data->token);
+
+      handler = Fgethash (token, ns_notify_pending, Qnil);
+      Fremhash (token, ns_notify_pending);
+
+      if (NILP (handler))
+	return unbind_to (count, Qnil);
+
+      switch (data->kind)
+	{
+	case ns_notify_result_authorization:
+	  {
+	    NSArray *pair = data->result;
+	    NSError *err = [pair objectAtIndex: 1];
+
+	    argument
+	      = list2 ([[pair objectAtIndex: 0] boolValue] ? Qt : Qnil,
+		       [err isKindOfClass: [NSError class]]
+		       ? ns_notify_string ([err localizedDescription])
+		       : Qnil);
+	  }
+	  break;
+
+	case ns_notify_result_settings:
+	  argument = ns_notify_lisp_from_settings (data->result);
+	  break;
+
+	case ns_notify_result_categories:
+	  {
+	    Lisp_Object list = Qnil;
+
+	    for (UNNotificationCategory *category in (NSSet *) data->result)
+	      list = Fcons (ns_notify_lisp_from_category (category), list);
+
+	    argument = Fnreverse (list);
+	  }
+	  break;
+
+	case ns_notify_result_notifications:
+	  {
+	    Lisp_Object list = Qnil;
+
+	    for (UNNotification *note in (NSArray *) data->result)
+	      list = Fcons (ns_notify_lisp_from_notification (note), list);
+
+	    argument = Fnreverse (list);
+	  }
+	  break;
+
+	case ns_notify_result_requests:
+	  {
+	    Lisp_Object list = Qnil;
+
+	    for (UNNotificationRequest *request in (NSArray *) data->result)
+	      list = Fcons (ns_notify_lisp_from_request (request), list);
+
+	    argument = Fnreverse (list);
+	  }
+	  break;
+
+	case ns_notify_result_error:
+	default:
+	  argument = ([data->result isKindOfClass: [NSError class]]
+		      ? ns_notify_string ([(NSError *) data->result
+					    localizedDescription])
+		      : Qnil);
+	  break;
+	}
+    }
+
+  EVENT_INIT (ie);
+  ie.kind = NOTIFICATION_EVENT;
+  ie.arg = list2 (handler, argument);
+  kbd_buffer_store_event (&ie);
+
+  return unbind_to (count, Qnil);
+}
+
+/* Swallow any nonlocal exit from ns_notify_deliver_1.  Letting one
+   unwind through the Objective C frames that called us would corrupt the
+   Cocoa runtime.  */
+
+static Lisp_Object
+ns_notify_deliver_2 (enum nonlocal_exit exit, Lisp_Object error)
+{
+  return Qnil;
+}
+
+/* Hand RESULT, of kind KIND, to the callback registered under TOKEN.
+   Must be called on the main thread.  */
+
+static void
+ns_notify_deliver (EMACS_INT token, enum ns_notify_result kind, id result)
+{
+  struct ns_notify_delivery data;
+
+  data.token = token;
+  data.kind = kind;
+  data.result = result;
+
+  internal_catch_all (ns_notify_deliver_1, &data, ns_notify_deliver_2);
+
+  /* Emacs is most likely blocked in ns_select with the Cocoa run loop
+     spinning; nudge it so that the event just queued is seen now rather
+     than whenever the next unrelated event arrives.  */
+#ifdef HAVE_PTHREAD
+  ns_run_loop_break ();
+#endif
+}
+
+/* Record FUNCTION as the callback for an asynchronous query and return
+   its token.  A completion block may capture the token, which is an
+   ordinary integer, but never FUNCTION itself, which the garbage
+   collector could not see.  */
+
+static EMACS_INT
+ns_notify_register (Lisp_Object function)
+{
+  EMACS_INT token = ++ns_notify_counter;
+
+  Fputhash (make_int (token), function, ns_notify_pending);
+
+  return token;
+}
+
+
+/* ==========================================================================
+
+    The notification centre delegate
+
+   ========================================================================== */
+
+@interface EmacsNotificationDelegate : NSObject <UNUserNotificationCenterDelegate>
+- (void)deliverResult: (NSArray *)packet;
+@end
+
+@implementation EmacsNotificationDelegate
+
+/* Convert PACKET, of (token, kind, result), into Lisp.  Completion
+   blocks arrive on an arbitrary queue and forward to this method so that
+   every Lisp object is made on the main thread.  */
+
+- (void)deliverResult: (NSArray *)packet
+{
+  id result = [packet objectAtIndex: 2];
+
+  ns_notify_deliver ([[packet objectAtIndex: 0] longLongValue],
+		     (enum ns_notify_result) [[packet objectAtIndex: 1]
+					       intValue],
+		     result == [NSNull null] ? nil : result);
+}
+
+/* Decide how a notification arriving while Emacs is frontmost should be
+   presented.  Without this method macOS shows nothing at all in that
+   case, which is the common one for a notification Emacs sent itself.  */
+
+- (void)userNotificationCenter: (UNUserNotificationCenter *)center
+       willPresentNotification: (UNNotification *)notification
+	 withCompletionHandler: (void (^)(UNNotificationPresentationOptions))
+				  completionHandler
+{
+  UNNotificationPresentationOptions options = 0;
+  Lisp_Object tail = Vns_notification_foreground_presentation;
+
+  /* Reading a list allocates nothing and runs no Lisp, so it is safe
+     here even though Emacs is inside its own event loop.  */
+  FOR_EACH_TAIL_SAFE (tail)
+    {
+      Lisp_Object option = XCAR (tail);
+
+      if (EQ (option, Qbanner))
+	options |= NS_UN_PRESENT_BANNER;
+      else if (EQ (option, Qlist))
+	options |= NS_UN_PRESENT_LIST;
+      else if (EQ (option, Qsound))
+	options |= UNNotificationPresentationOptionSound;
+      else if (EQ (option, Qbadge))
+	options |= UNNotificationPresentationOptionBadge;
+    }
+
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 110000
+  /* Before macOS 11 there was one combined alert option.  */
+  if (options & (NS_UN_PRESENT_BANNER | NS_UN_PRESENT_LIST))
+    options |= UNNotificationPresentationOptionAlert;
+#endif
+
+  completionHandler (options);
+}
+
+/* Report that the user acted on a notification.  */
+
+- (void)userNotificationCenter: (UNUserNotificationCenter *)center
+didReceiveNotificationResponse: (UNNotificationResponse *)response
+	 withCompletionHandler: (void (^)(void))completionHandler
+{
+  ns_notify_deliver (0, ns_notify_result_error, response);
+  completionHandler ();
+}
+
+@end
+
+/* Hand PACKET to the delegate on the main thread.  Called from
+   completion blocks, on whatever queue the framework chose.  */
+
+static void
+ns_notify_forward (EMACS_INT token, enum ns_notify_result kind, id result)
+{
+  NSArray *packet = @[[NSNumber numberWithLongLong: token],
+		      [NSNumber numberWithInt: (int) kind],
+		      result ? result : (id) [NSNull null]];
+
+  [ns_notify_delegate performSelectorOnMainThread: @selector (deliverResult:)
+				       withObject: packet
+				    waitUntilDone: NO];
+}
+
+void
+ns_init_notifications (void)
+{
+  if (ns_notify_delegate != nil || !ns_notify_available_p ())
+    return;
+
+  @try
+    {
+      ns_notify_delegate = [[EmacsNotificationDelegate alloc] init];
+      [[UNUserNotificationCenter currentNotificationCenter]
+	setDelegate: ns_notify_delegate];
+    }
+  @catch (NSException *exception)
+    {
+      [ns_notify_delegate release];
+      ns_notify_delegate = nil;
+      ns_notify_availability = 0;
+    }
+}
+
+
+/* ==========================================================================
+
+    Building requests
+
+   ========================================================================== */
+
+/* Return VALUE as an NSString, signalling unless it is a string.  KEY
+   names it, for the error message.  */
+
+static NSString *
+ns_notify_required_string (Lisp_Object value, const char *key)
+{
+  if (!STRINGP (value))
+    error ("Value of %s must be a string", key);
+
+  return [NSString stringWithLispString: value];
+}
+
+/* Return the sound described by VALUE: t or `default' for the system
+   default, a string for a sound of that name, nil for silence.  */
+
+static UNNotificationSound *
+ns_notify_sound (Lisp_Object value)
+{
+  if (NILP (value))
+    return nil;
+
+  if (EQ (value, Qt) || EQ (value, Qdefault))
+    return [UNNotificationSound defaultSound];
+
+  return [UNNotificationSound
+	   soundNamed: ns_notify_required_string (value, ":sound")];
+}
+
+/* Attach the files described by the list VALUE to CONTENT.  Each element
+   is a property list; only `:file' is required.  Note that the framework
+   copies each file into its own store, so a temporary file may be
+   deleted once this returns.  */
+
+static void
+ns_notify_add_attachments (UNMutableNotificationContent *content,
+			   Lisp_Object value)
+{
+  NSMutableArray *attachments = [NSMutableArray array];
+  Lisp_Object tail = value;
+
+  FOR_EACH_TAIL (tail)
+    {
+      Lisp_Object spec = XCAR (tail);
+      Lisp_Object file = plist_get (spec, QCfile);
+      Lisp_Object id = plist_get (spec, QCid);
+      Lisp_Object hint = plist_get (spec, QCtype_hint);
+      Lisp_Object time = plist_get (spec, QCthumbnail_time);
+      NSMutableDictionary *options = [NSMutableDictionary dictionary];
+      UNNotificationAttachment *attachment;
+      /* Not `error': that would shadow the function of the same name.  */
+      NSError *problem = nil;
+      NSURL *url;
+
+      if (!STRINGP (file))
+	error ("Attachment has no :file");
+
+      url = [NSURL fileURLWithPath:
+		     [NSString stringWithLispString:
+				 ENCODE_FILE (Fexpand_file_name (file,
+								 Qnil))]];
+
+      if (STRINGP (hint))
+	[options setObject: [NSString stringWithLispString: hint]
+		    forKey: UNNotificationAttachmentOptionsTypeHintKey];
+
+      if (!NILP (plist_get (spec, QCthumbnail_hidden)))
+	[options setObject: [NSNumber numberWithBool: YES]
+		    forKey:
+		      UNNotificationAttachmentOptionsThumbnailHiddenKey];
+
+      if (NUMBERP (time))
+	[options setObject: [NSNumber numberWithDouble: XFLOATINT (time)]
+		    forKey:
+		      UNNotificationAttachmentOptionsThumbnailTimeKey];
+
+      attachment
+	= [UNNotificationAttachment
+	    attachmentWithIdentifier: (STRINGP (id)
+				       ? [NSString stringWithLispString: id]
+				       : @"")
+				 URL: url
+			     options: options
+			       error: &problem];
+
+      if (!attachment)
+	error ("Cannot attach %s: %s", SSDATA (file),
+	       [[problem localizedDescription] UTF8String]);
+
+      [attachments addObject: attachment];
+    }
+
+  [content setAttachments: attachments];
+}
+
+/* Apply `:urgency'-style VALUE to CONTENT as an interruption level.  */
+
+static void
+ns_notify_set_interruption_level (UNMutableNotificationContent *content,
+				  Lisp_Object value)
+{
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 120000
+  UNNotificationInterruptionLevel level;
+
+  /* Interruption levels arrived in macOS 12.  On anything older the
+     notification simply keeps the default treatment.  */
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 120000
+  if (![content respondsToSelector: @selector (setInterruptionLevel:)])
+    return;
+#endif
+
+  if (EQ (value, Qpassive))
+    level = UNNotificationInterruptionLevelPassive;
+  else if (EQ (value, Qactive))
+    level = UNNotificationInterruptionLevelActive;
+  else if (EQ (value, Qtime_sensitive))
+    level = UNNotificationInterruptionLevelTimeSensitive;
+  else if (EQ (value, Qcritical))
+    /* A genuinely critical alert additionally needs an entitlement
+       granted by Apple, which Emacs does not have; without it the system
+       quietly treats this as time sensitive.  */
+    level = UNNotificationInterruptionLevelCritical;
+  else
+    error ("Invalid interruption level");
+
+  [content setInterruptionLevel: level];
+#endif
+}
+
+/* Return the trigger described by AFTER, AT and REPEAT, or nil to
+   deliver the notification immediately.  */
+
+static UNNotificationTrigger *
+ns_notify_trigger (Lisp_Object after, Lisp_Object at, Lisp_Object repeat)
+{
+  BOOL repeats = !NILP (repeat);
+
+  if (!NILP (after))
+    {
+      double interval;
+
+      CHECK_NUMBER (after);
+      interval = XFLOATINT (after);
+
+      if (interval <= 0)
+	error (":after must be a positive number of seconds");
+
+      /* The framework rejects a repeating interval under a minute.  */
+      if (repeats && interval < 60)
+	error ("A repeating :after must be at least 60 seconds");
+
+      return [UNTimeIntervalNotificationTrigger
+	       triggerWithTimeInterval: interval repeats: repeats];
+    }
+
+  if (!NILP (at))
+    {
+      NSDateComponents *components = [[[NSDateComponents alloc] init]
+				       autorelease];
+      Lisp_Object value;
+
+      value = plist_get (at, QCyear);
+      if (!NILP (value))
+	[components setYear: check_integer_range (value, 1, 9999)];
+      value = plist_get (at, QCmonth);
+      if (!NILP (value))
+	[components setMonth: check_integer_range (value, 1, 12)];
+      value = plist_get (at, QCday);
+      if (!NILP (value))
+	[components setDay: check_integer_range (value, 1, 31)];
+      value = plist_get (at, QChour);
+      if (!NILP (value))
+	[components setHour: check_integer_range (value, 0, 23)];
+      value = plist_get (at, QCminute);
+      if (!NILP (value))
+	[components setMinute: check_integer_range (value, 0, 59)];
+      value = plist_get (at, QCsecond);
+      if (!NILP (value))
+	[components setSecond: check_integer_range (value, 0, 59)];
+      value = plist_get (at, QCweekday);
+      if (!NILP (value))
+	[components setWeekday: check_integer_range (value, 1, 7)];
+
+      return [UNCalendarNotificationTrigger
+	       triggerWithDateMatchingComponents: components
+					 repeats: repeats];
+    }
+
+  return nil;
+}
+
+
+/* ==========================================================================
+
+    Lisp interface
+
+   ========================================================================== */
+
+DEFUN ("ns-notification-available-p", Fns_notification_available_p,
+       Sns_notification_available_p, 0, 0, 0,
+       doc: /* Return non-nil if this Emacs can post notifications.
+
+Notifications require macOS 10.14 or later and, because the system
+identifies the sender by its bundle, an Emacs running from an application
+bundle that Launch Services knows about.  Running the `emacs' executable
+directly from a build tree therefore returns nil.
+
+Callers that can fall back on another notification backend should test
+this rather than `fboundp': the functions in this file are defined when
+Emacs is dumped, long before the answer here is known.  */)
+  (void)
+{
+  return ns_notify_available_p () ? Qt : Qnil;
+}
+
+DEFUN ("ns-notification-request-authorization",
+       Fns_notification_request_authorization,
+       Sns_notification_request_authorization, 0, 2, 0,
+       doc: /* Ask the user to allow Emacs to post notifications.
+
+OPTIONS is a list of symbols naming what to ask for; it defaults to
+`(alert sound badge)'.  The recognized symbols are:
+
+  `alert'        Display notifications on screen.
+  `sound'        Play sounds with notifications.
+  `badge'        Set a count on the Dock icon.
+  `provisional'  Deliver quietly to Notification Center without asking
+                 the user anything.  Cannot be combined usefully with
+                 the others, which do prompt.
+
+The system prompts the user only the first time it is asked; afterwards
+it answers from the choice already recorded, which the user can revisit
+in System Settings.
+
+If HANDLER is non-nil, call it once the answer is known, with two
+arguments: non-nil if permission was granted, and a string describing the
+failure or nil.  The call happens later, from the command loop, not
+before this function returns.  */)
+  (Lisp_Object options, Lisp_Object handler)
+{
+  UNAuthorizationOptions mask = 0;
+  UNUserNotificationCenter *center = ns_notify_center ();
+  EMACS_INT token = NILP (handler) ? 0 : ns_notify_register (handler);
+
+  if (NILP (options))
+    mask = (UNAuthorizationOptionAlert | UNAuthorizationOptionSound
+	    | UNAuthorizationOptionBadge);
+  else
+    {
+      Lisp_Object tail = options;
+
+      FOR_EACH_TAIL (tail)
+	{
+	  Lisp_Object option = XCAR (tail);
+
+	  if (EQ (option, Qalert))
+	    mask |= UNAuthorizationOptionAlert;
+	  else if (EQ (option, Qsound))
+	    mask |= UNAuthorizationOptionSound;
+	  else if (EQ (option, Qbadge))
+	    mask |= UNAuthorizationOptionBadge;
+	  else if (EQ (option, Qprovisional))
+	    mask |= UNAuthorizationOptionProvisional;
+	  else
+	    error ("Invalid authorization option");
+	}
+    }
+
+  block_input ();
+  [center requestAuthorizationWithOptions: mask
+			completionHandler: ^(BOOL granted, NSError *problem)
+    {
+      if (token)
+	ns_notify_forward (token, ns_notify_result_authorization,
+			   @[[NSNumber numberWithBool: granted],
+			     problem ? (id) problem : (id) [NSNull null]]);
+    }];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-get-settings", Fns_notification_get_settings,
+       Sns_notification_get_settings, 1, 1, 0,
+       doc: /* Report what the system currently permits.
+
+Call HANDLER, later and from the command loop, with one argument: a
+property list describing the current settings.  Its keys are
+`:authorization-status', `:alert-setting', `:sound-setting',
+`:badge-setting', `:notification-center-setting', `:lock-screen-setting',
+`:alert-style' and `:show-previews', plus `:time-sensitive-setting' and
+`:scheduled-delivery-setting' on macOS 12 and later.
+
+`:authorization-status' is one of `not-determined', `denied',
+`authorized' or `provisional'.  Each `...-setting' is `enabled',
+`disabled' or `not-supported'.  `:alert-style' is `none', `banner' or
+`alert', and `:show-previews' is `always', `when-authenticated' or
+`never'.  */)
+  (Lisp_Object handler)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  EMACS_INT token;
+
+  CHECK_TYPE (FUNCTIONP (handler), Qfunctionp, handler);
+  token = ns_notify_register (handler);
+
+  block_input ();
+  [center getNotificationSettingsWithCompletionHandler:
+	    ^(UNNotificationSettings *settings)
+    {
+      ns_notify_forward (token, ns_notify_result_settings, settings);
+    }];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-set-categories", Fns_notification_set_categories,
+       Sns_notification_set_categories, 1, 1, 0,
+       doc: /* Register CATEGORIES, replacing any registered before.
+
+A category names a set of buttons that a notification can offer.  The
+framework has no way to attach buttons to one notification directly: a
+notification names a category, and the category supplies the buttons.
+
+CATEGORIES is a list of property lists, each accepting:
+
+  :id       String naming the category.  Required.
+  :actions  List of property lists describing the buttons, in order.
+  :intents  List of intent identifier strings.
+  :options  List of symbols from `custom-dismiss',
+            `hidden-previews-show-title' and
+            `hidden-previews-show-subtitle'.
+
+Include `custom-dismiss' if you want to be told when the user dismisses
+the notification; without it, dismissal is silent.
+
+Each action property list accepts:
+
+  :id             String naming the action.  Required.  This is what
+                  identifies the button in a response.
+  :title          String shown on the button.  Required.
+  :foreground     Bring Emacs to the front when chosen.
+  :destructive    Draw the button as a destructive choice.
+  :authenticate   Require the device be unlocked first.
+  :text-input     Let the user type a reply instead of just clicking.
+  :button-title   String on the send button of a `:text-input' action.
+  :placeholder    Placeholder string for its text field.
+
+This replaces the whole set, so callers should register everything they
+need at once.  `ns-notification-define-category' keeps a registry and
+does that for you.  */)
+  (Lisp_Object categories)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  NSMutableSet *set = [NSMutableSet set];
+  Lisp_Object tail = categories;
+
+  FOR_EACH_TAIL (tail)
+    {
+      Lisp_Object spec = XCAR (tail);
+      Lisp_Object actions = plist_get (spec, QCactions);
+      Lisp_Object intents = plist_get (spec, QCintents);
+      Lisp_Object options = plist_get (spec, QCoptions);
+      NSMutableArray *action_list = [NSMutableArray array];
+      NSMutableArray *intent_list = [NSMutableArray array];
+      UNNotificationCategoryOptions mask = 0;
+      Lisp_Object inner;
+
+      inner = actions;
+      FOR_EACH_TAIL (inner)
+	{
+	  Lisp_Object action = XCAR (inner);
+	  NSString *identifier
+	    = ns_notify_required_string (plist_get (action, QCid), ":id");
+	  NSString *title
+	    = ns_notify_required_string (plist_get (action, QCtitle),
+					 ":title");
+	  UNNotificationActionOptions action_mask = 0;
+
+	  if (!NILP (plist_get (action, QCforeground)))
+	    action_mask |= UNNotificationActionOptionForeground;
+	  if (!NILP (plist_get (action, QCdestructive)))
+	    action_mask |= UNNotificationActionOptionDestructive;
+	  if (!NILP (plist_get (action, QCauthenticate)))
+	    action_mask |= UNNotificationActionOptionAuthenticationRequired;
+
+	  if (NILP (plist_get (action, QCtext_input)))
+	    [action_list addObject:
+			   [UNNotificationAction
+			     actionWithIdentifier: identifier
+					    title: title
+					  options: action_mask]];
+	  else
+	    {
+	      Lisp_Object button = plist_get (action, QCbutton_title);
+	      Lisp_Object placeholder = plist_get (action, QCplaceholder);
+
+	      [action_list addObject:
+			     [UNTextInputNotificationAction
+			       actionWithIdentifier: identifier
+					      title: title
+					    options: action_mask
+			       textInputButtonTitle:
+				 (STRINGP (button)
+				  ? [NSString stringWithLispString: button]
+				  : @"Send")
+			       textInputPlaceholder:
+				 (STRINGP (placeholder)
+				  ? [NSString stringWithLispString:
+						placeholder]
+				  : @"")]];
+	    }
+	}
+
+      inner = intents;
+      FOR_EACH_TAIL (inner)
+	[intent_list addObject:
+		       ns_notify_required_string (XCAR (inner), ":intents")];
+
+      inner = options;
+      FOR_EACH_TAIL (inner)
+	{
+	  Lisp_Object option = XCAR (inner);
+
+	  if (EQ (option, Qcustom_dismiss))
+	    mask |= UNNotificationCategoryOptionCustomDismissAction;
+	  else if (EQ (option, Qhidden_previews_show_title))
+	    mask |= UNNotificationCategoryOptionHiddenPreviewsShowTitle;
+	  else if (EQ (option, Qhidden_previews_show_subtitle))
+	    mask |= UNNotificationCategoryOptionHiddenPreviewsShowSubtitle;
+	  else
+	    error ("Invalid category option");
+	}
+
+      [set addObject:
+	     [UNNotificationCategory
+	       categoryWithIdentifier:
+		 ns_notify_required_string (plist_get (spec, QCid), ":id")
+			      actions: action_list
+		    intentIdentifiers: intent_list
+			      options: mask]];
+    }
+
+  block_input ();
+  [center setNotificationCategories: set];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-get-categories", Fns_notification_get_categories,
+       Sns_notification_get_categories, 1, 1, 0,
+       doc: /* Report the categories registered with the system.
+
+Call HANDLER, later and from the command loop, with one argument: a list
+of property lists in the form `ns-notification-set-categories' accepts.  */)
+  (Lisp_Object handler)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  EMACS_INT token;
+
+  CHECK_TYPE (FUNCTIONP (handler), Qfunctionp, handler);
+  token = ns_notify_register (handler);
+
+  block_input ();
+  [center getNotificationCategoriesWithCompletionHandler:
+	    ^(NSSet *categories)
+    {
+      ns_notify_forward (token, ns_notify_result_categories, categories);
+    }];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-add", Fns_notification_add, Sns_notification_add,
+       1, 1, 0,
+       doc: /* Post the notification described by the property list PLIST.
+
+Return the identifier of the notification, a string.  Posting a
+notification whose identifier matches one already posted replaces it.
+
+This is the primitive underlying `ns-notification-notify', which is
+easier to use and which is what most callers should reach for.
+
+PLIST accepts:
+
+  :id            String identifying the notification.  One is generated
+                 if this is omitted.
+  :title         String shown as the heading.
+  :subtitle      String shown under the title.
+  :body          String of body text.
+  :category      Identifier of a category registered with
+                 `ns-notification-set-categories', supplying the buttons.
+  :group         String grouping related notifications together in
+                 Notification Center.
+  :sound         t or `default' for the system sound, a string naming a
+                 sound in ~/Library/Sounds or /System/Library/Sounds, or
+                 nil for silence.
+  :badge         Integer to show on the Dock icon.
+  :attachments   List of property lists, each with a `:file' and
+                 optionally `:id', `:type-hint', `:thumbnail-hidden' and
+                 `:thumbnail-time'.  Each file is copied into the
+                 system's own store, so a temporary file may be deleted
+                 once this returns.
+  :user-info     Any printable Lisp object, handed back unchanged to the
+                 handler of a response.  Unlike anything held in this
+                 Emacs session, it survives into a later one, because
+                 the system stores it alongside the notification.
+  :interruption-level
+                 One of `passive', `active', `time-sensitive' or
+                 `critical'.  Ignored before macOS 12.  Note that
+                 `critical' needs an entitlement Emacs does not have.
+  :relevance-score
+                 Float between 0.0 and 1.0 ordering notifications within
+                 a group.  Ignored before macOS 12.
+  :after         Deliver this many seconds from now rather than at once.
+  :at            Deliver at a matching date, given as a property list of
+                 `:year', `:month', `:day', `:hour', `:minute',
+                 `:second' and `:weekday'.
+  :repeat        Deliver repeatedly.  With `:after' the interval must be
+                 at least 60 seconds.
+  :handler       Function called, later and from the command loop, with
+                 one argument: a string describing why the notification
+                 could not be posted, or nil on success.
+
+A notification with no trigger is delivered immediately.  Note that
+macOS suppresses notifications from the frontmost application unless
+`ns-notification-foreground-presentation' says otherwise.  */)
+  (Lisp_Object plist)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  UNMutableNotificationContent *content;
+  UNNotificationRequest *request;
+  Lisp_Object value, id, handler;
+  EMACS_INT token;
+  NSString *identifier;
+
+  CHECK_LIST (plist);
+
+  id = plist_get (plist, QCid);
+  if (NILP (id))
+    {
+      /* Identifiers must be unique among live notifications but are
+	 otherwise arbitrary.  Include the process id so that two Emacs
+	 sessions cannot displace each other's notifications.  */
+      char buffer[INT_STRLEN_BOUND (intmax_t) * 2 + sizeof "emacs--"];
+
+      sprintf (buffer, "emacs-%"PRIdMAX"-%"PRIdMAX,
+	       (intmax_t) getpid (), (intmax_t) ++ns_notify_counter);
+      id = build_string (buffer);
+    }
+  else if (!STRINGP (id))
+    error ("Value of :id must be a string");
+
+  identifier = [NSString stringWithLispString: id];
+  handler = plist_get (plist, QChandler);
+  token = NILP (handler) ? 0 : ns_notify_register (handler);
+
+  content = [[[UNMutableNotificationContent alloc] init] autorelease];
+
+  value = plist_get (plist, QCtitle);
+  if (!NILP (value))
+    [content setTitle: ns_notify_required_string (value, ":title")];
+
+  value = plist_get (plist, QCsubtitle);
+  if (!NILP (value))
+    [content setSubtitle: ns_notify_required_string (value, ":subtitle")];
+
+  value = plist_get (plist, QCbody);
+  if (!NILP (value))
+    [content setBody: ns_notify_required_string (value, ":body")];
+
+  value = plist_get (plist, QCcategory);
+  if (!NILP (value))
+    [content setCategoryIdentifier:
+	       ns_notify_required_string (value, ":category")];
+
+  value = plist_get (plist, QCgroup);
+  if (!NILP (value))
+    [content setThreadIdentifier:
+	       ns_notify_required_string (value, ":group")];
+
+  value = plist_get (plist, QCbadge);
+  if (!NILP (value))
+    {
+      CHECK_FIXNAT (value);
+      [content setBadge: [NSNumber numberWithLongLong: XFIXNAT (value)]];
+    }
+
+  [content setSound: ns_notify_sound (plist_get (plist, QCsound))];
+
+  value = plist_get (plist, QCattachments);
+  if (!NILP (value))
+    ns_notify_add_attachments (content, value);
+
+  value = plist_get (plist, QCinterruption_level);
+  if (!NILP (value))
+    ns_notify_set_interruption_level (content, value);
+
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 120000
+  value = plist_get (plist, QCrelevance_score);
+  if (!NILP (value))
+    {
+      CHECK_NUMBER (value);
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 120000
+      if ([content respondsToSelector: @selector (setRelevanceScore:)])
+#endif
+	[content setRelevanceScore: XFLOATINT (value)];
+    }
+#endif
+
+  /* `:user-info' has to round trip through a property list dictionary,
+     so store it printed and read it back on the way out.  */
+  value = plist_get (plist, QCuser_info);
+  if (!NILP (value))
+    [content setUserInfo:
+	       @{NS_NOTIFY_USER_INFO_KEY:
+		   [NSString stringWithLispString:
+			       Fprin1_to_string (value, Qnil, Qnil)]}];
+
+  request = [UNNotificationRequest
+	      requestWithIdentifier: identifier
+			    content: content
+			    trigger: ns_notify_trigger (plist_get (plist,
+								   QCafter),
+							plist_get (plist,
+								   QCat),
+							plist_get (plist,
+								   QCrepeat))];
+
+  block_input ();
+  [center addNotificationRequest: request
+	   withCompletionHandler: ^(NSError *problem)
+    {
+      if (token)
+	ns_notify_forward (token, ns_notify_result_error, problem);
+    }];
+  unblock_input ();
+
+  return id;
+}
+
+DEFUN ("ns-notification-remove", Fns_notification_remove,
+       Sns_notification_remove, 1, 2, 0,
+       doc: /* Withdraw the notifications named by IDS, a list of strings.
+
+Delivered notifications are removed from Notification Center.  If PENDING
+is non-nil, remove notifications that are scheduled but not yet delivered
+instead.  Identifiers that name nothing are ignored.  */)
+  (Lisp_Object ids, Lisp_Object pending)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  NSMutableArray *list = [NSMutableArray array];
+  Lisp_Object tail = ids;
+
+  if (STRINGP (ids))
+    tail = list1 (ids);
+
+  FOR_EACH_TAIL (tail)
+    [list addObject: ns_notify_required_string (XCAR (tail), "IDS")];
+
+  block_input ();
+  if (NILP (pending))
+    [center removeDeliveredNotificationsWithIdentifiers: list];
+  else
+    [center removePendingNotificationRequestsWithIdentifiers: list];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-remove-all", Fns_notification_remove_all,
+       Sns_notification_remove_all, 0, 1, 0,
+       doc: /* Withdraw every notification Emacs has delivered.
+
+If PENDING is non-nil, cancel every notification Emacs has scheduled but
+which has not been delivered yet, instead.  */)
+  (Lisp_Object pending)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+
+  block_input ();
+  if (NILP (pending))
+    [center removeAllDeliveredNotifications];
+  else
+    [center removeAllPendingNotificationRequests];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-get-delivered", Fns_notification_get_delivered,
+       Sns_notification_get_delivered, 1, 1, 0,
+       doc: /* Report the notifications still showing in Notification Center.
+
+Call HANDLER, later and from the command loop, with one argument: a list
+of property lists, each with `:id', `:title', `:subtitle', `:body',
+`:category', `:group', `:user-info' and `:date'.  */)
+  (Lisp_Object handler)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  EMACS_INT token;
+
+  CHECK_TYPE (FUNCTIONP (handler), Qfunctionp, handler);
+  token = ns_notify_register (handler);
+
+  block_input ();
+  [center getDeliveredNotificationsWithCompletionHandler:
+	    ^(NSArray *notifications)
+    {
+      ns_notify_forward (token, ns_notify_result_notifications,
+			 notifications);
+    }];
+  unblock_input ();
+
+  return Qnil;
+}
+
+DEFUN ("ns-notification-get-pending", Fns_notification_get_pending,
+       Sns_notification_get_pending, 1, 1, 0,
+       doc: /* Report the notifications scheduled but not yet delivered.
+
+Call HANDLER, later and from the command loop, with one argument: a list
+of property lists, each with `:id', `:title', `:subtitle', `:body',
+`:category', `:group' and `:user-info'.  */)
+  (Lisp_Object handler)
+{
+  UNUserNotificationCenter *center = ns_notify_center ();
+  EMACS_INT token;
+
+  CHECK_TYPE (FUNCTIONP (handler), Qfunctionp, handler);
+  token = ns_notify_register (handler);
+
+  block_input ();
+  [center getPendingNotificationRequestsWithCompletionHandler:
+	    ^(NSArray *requests)
+    {
+      ns_notify_forward (token, ns_notify_result_requests, requests);
+    }];
+  unblock_input ();
+
+  return Qnil;
+}
+
+#else /* !NS_USE_USER_NOTIFICATIONS */
+
+void
+ns_init_notifications (void)
+{
+}
+
+#endif /* !NS_USE_USER_NOTIFICATIONS */
